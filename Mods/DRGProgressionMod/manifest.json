{
    "mod_id": "drg.progression",
    "name": "Deep Rock Galactic Progression",
    "version": "1.0.0",
    "description": "AP Framework progression mod for DRG - demonstrates requires_any, requires_count, ^-prefixed items, and option conditionals",
    "enabled": true,
    "options": {
        "shuffle_overclocks": {
            "type": "toggle",
            "default": false,
            "description": "Shuffle weapon overclocks into the randomizer pool"
        },
        "assignment_mode": {
            "type": "text_choice",
            "choices": ["Off", "Weekly", "All"],
            "default": "Weekly",
            "description": "How assignment rewards are randomized: Off (vanilla), Weekly (only weekly assignments), All (all assignments)"
        }
    },
    "capabilities": {
        "regions": [
            { "name": "Crystalline Caverns" },
            { "name": "Salt Pits" },
            { "name": "Sandblasted Corridors", "requires_any": ["Driller Unlock", "Engineer Unlock"] },
            { "name": "Fungus Bogs", "requires": ["Hazard 3 Clearance"] },
            { "name": "Radioactive Zone", "requires": ["Hazard 3 Clearance", "Lead Suit"] },
            { "name": "Glacial Strata", "requires": ["Hazard 4 Clearance"] },
            { "name": "Magma Core", "requires": ["Hazard 4 Clearance"],
              "requires_any": ["Driller Unlock", "Scout Unlock"] },
            { "name": "Deep Dive", "requires": ["Hazard 5 Clearance"],
              "requires_count": [{"item": "^Blank Core", "count": 3}] }
        ],
        "items": [
            { "name": "Driller Unlock", "type": "progression", "amount": 1,
              "action": "DRG.UnlockClass",
              "args": [{"name": "class", "type": "string", "value": "driller"}] },
            { "name": "Engineer Unlock", "type": "progression", "amount": 1,
              "action": "DRG.UnlockClass",
              "args": [{"name": "class", "type": "string", "value": "engineer"}] },
            { "name": "Scout Unlock", "type": "progression", "amount": 1,
              "action": "DRG.UnlockClass",
              "args": [{"name": "class", "type": "string", "value": "scout"}] },
            { "name": "Hazard 3 Clearance", "type": "progression", "amount": 1,
              "action": "DRG.UnlockHazard",
              "args": [{"name": "level", "type": "number", "value": 3}] },
            { "name": "Hazard 4 Clearance", "type": "progression", "amount": 1,
              "action": "DRG.UnlockHazard",
              "args": [{"name": "level", "type": "number", "value": 4}] },
            { "name": "Hazard 5 Clearance", "type": "progression", "amount": 1,
              "action": "DRG.UnlockHazard",
              "args": [{"name": "level", "type": "number", "value": 5}] },
            { "name": "Lead Suit", "type": "progression", "amount": 1,
              "action": "DRG.UnlockEquipment",
              "args": [{"name": "equipment", "type": "string", "value": "lead_suit"}] },
            { "name": "^Blank Core", "type": "progression", "amount": 6,
              "action": "DRG.GrantCore",
              "args": [{"name": "type", "type": "string", "value": "blank"}] },
            { "name": "^Overclock Token", "type": "useful", "amount": 8,
              "requires_option": "shuffle_overclocks",
              "action": "DRG.GrantOverclock",
              "args": [] },
            { "name": "Credits Bundle", "type": "filler", "amount": -1,
              "action": "DRG.GrantCredits",
              "args": [{"name": "amount", "type": "number", "value": 5000}] },
            { "name": "Minerals Bundle", "type": "filler", "amount": -1,
              "action": "DRG.GrantMinerals",
              "args": [{"name": "amount", "type": "number", "value": 100}] },
            { "name": "Bulk Detonator Trap", "type": "trap", "amount": -1,
              "action": "DRG.SpawnHostile",
              "args": [{"name": "creature", "type": "string", "value": "bulk_detonator"}] }
        ],
        "locations": [
            { "name": "Caverns - Mining Expedition", "region": "Crystalline Caverns" },
            { "name": "Caverns - Egg Hunt", "region": "Crystalline Caverns" },
            { "name": "Salt Pits - Point Extraction", "region": "Salt Pits" },
            { "name": "Salt Pits - Salvage Op", "region": "Salt Pits" },
            { "name": "Sandblasted - Escort Duty", "region": "Sandblasted Corridors" },
            { "name": "Sandblasted - Elimination", "region": "Sandblasted Corridors" },
            { "name": "Fungus - On-Site Refinery", "region": "Fungus Bogs" },
            { "name": "Fungus - Industrial Sabotage", "region": "Fungus Bogs" },
            { "name": "Radioactive - Escort Duty", "region": "Radioactive Zone" },
            { "name": "Radioactive - Deep Scan", "region": "Radioactive Zone" },
            { "name": "Glacial - Egg Hunt", "region": "Glacial Strata" },
            { "name": "Glacial - Mining Expedition", "region": "Glacial Strata" },
            { "name": "Magma Core - Elimination", "region": "Magma Core" },
            { "name": "Magma Core - Point Extraction", "region": "Magma Core" },
            { "name": "Deep Dive - Stage 1", "region": "Deep Dive" },
            { "name": "Deep Dive - Stage 2", "region": "Deep Dive" },
            { "name": "Deep Dive - Stage 3", "region": "Deep Dive" },
            { "name": "Weekly Assignment 1",
              "requires_option": "assignment_mode" },
            { "name": "Weekly Assignment 2",
              "requires_option": "assignment_mode" },
            { "name": "Daily Assignment 1",
              "requires_option": "assignment_mode=All" },
            { "name": "Daily Assignment 2",
              "requires_option": "assignment_mode=All" },
            { "name": "Overclock Forge 1",
              "requires_option": "shuffle_overclocks",
              "requires_count": [{"item": "^Blank Core", "count": 1}] },
            { "name": "Overclock Forge 2",
              "requires_option": "shuffle_overclocks",
              "requires_count": [{"item": "^Blank Core", "count": 2}] },
            { "name": "Overclock Forge 3",
              "requires_option": "shuffle_overclocks",
              "requires_count": [{"item": "^Blank Core", "count": 3}] }
        ]
    }
}
