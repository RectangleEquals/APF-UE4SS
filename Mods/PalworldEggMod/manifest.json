{
    "mod_id": "spectrecular.palworld.eggs",
    "name": "Palworld Egg Mode",
    "version": "1.0.0",
    "enabled": true,
    "depends": ["spectrecular.palworld.techshuffle"],
    "options": {
        "egg_mode": {
            "type": "toggle",
            "default": false,
            "description": "Complete your Paldex by hatching eggs instead of capturing"
        }
    },
    "goals": [
        {
            "name": "complete_paldex",
            "display": "Complete the Paldex",
            "description": "Register all Pals via hatching",
            "logic": "(Item: Paldex Entry : 137)"
        }
    ],
    "capabilities": {
        "include": ["techshuffle/regions.json"],
        "overrides": {
            "items": [
                {
                    "target_item": "Tech Unlock: Special_PalSphere_Grade_01",
                    "target_mod": "spectrecular.palworld.techshuffle",
                    "type": "filler",
                    "logic": "(Option: egg_mode)"
                }
            ]
        },
        "items": [
            {
                "name": "Pal Breeding License",
                "type": "progression",
                "amount": 1,
                "logic": "(Option: egg_mode)",
                "action": "EggMod.GrantBreedingLicense",
                "args": []
            },
            {
                "name": "Paldex Entry",
                "type": "progression",
                "amount": 137,
                "logic": "(Option: egg_mode)"
            },
            {
                "name": "Mystery Egg",
                "type": "filler",
                "amount": -1,
                "logic": "(Option: egg_mode)"
            }
        ],
        "locations": [
            {
                "name": "Hatch: Cattiva Egg",
                "logic": "(Can Access: Tech Tier 1) AND (Option: egg_mode) AND (Item: Pal Breeding License)"
            },
            {
                "name": "Hatch: Grizzbolt Egg",
                "logic": "(Can Access: Post-Grass Boss) AND (Option: egg_mode) AND (Item: Pal Breeding License)"
            }
        ]
    }
}
