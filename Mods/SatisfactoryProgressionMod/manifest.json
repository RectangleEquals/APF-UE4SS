{
    "mod_id": "satisfactory.progression",
    "name": "Satisfactory Progression",
    "version": "1.0.0",
    "description": "AP Framework progression mod for Satisfactory - demonstrates regions, requirements, and option conditionals",
    "enabled": true,
    "options": {
        "shuffle_hard_drives": {
            "type": "toggle",
            "default": true,
            "description": "Shuffle hard drive locations into the randomizer pool"
        },
        "milestone_shuffle": {
            "type": "text_choice",
            "choices": ["Off", "Tiered", "Full"],
            "default": "Tiered",
            "description": "How HUB milestones are shuffled: Off (vanilla), Tiered (within-tier), Full (all mixed)"
        }
    },
    "capabilities": {
        "regions": [
            { "name": "Grasslands" },
            { "name": "Desert", "requires": ["Blade Runners"] },
            { "name": "Forest", "requires": ["Chainsaw"] },
            { "name": "Swamp", "requires": ["Blade Runners", "Gas Mask"] },
            { "name": "Red Jungle", "requires_any": ["Jetpack", "Hover Pack"], "requires": ["Rifle"] }
        ],
        "items": [
            { "name": "Blade Runners", "type": "progression", "amount": 1,
              "action": "Satisfactory.UnlockEquipment",
              "args": [{"name": "equipment", "type": "string", "value": "blade_runners"}] },
            { "name": "Chainsaw", "type": "progression", "amount": 1,
              "action": "Satisfactory.UnlockEquipment",
              "args": [{"name": "equipment", "type": "string", "value": "chainsaw"}] },
            { "name": "Gas Mask", "type": "progression", "amount": 1,
              "action": "Satisfactory.UnlockEquipment",
              "args": [{"name": "equipment", "type": "string", "value": "gas_mask"}] },
            { "name": "Jetpack", "type": "progression", "amount": 1,
              "action": "Satisfactory.UnlockEquipment",
              "args": [{"name": "equipment", "type": "string", "value": "jetpack"}] },
            { "name": "Hover Pack", "type": "progression", "amount": 1,
              "action": "Satisfactory.UnlockEquipment",
              "args": [{"name": "equipment", "type": "string", "value": "hover_pack"}] },
            { "name": "Rifle", "type": "progression", "amount": 1,
              "action": "Satisfactory.UnlockEquipment",
              "args": [{"name": "equipment", "type": "string", "value": "rifle"}] },
            { "name": "HUB Parts", "type": "progression", "amount": 8,
              "action": "Satisfactory.GrantHubPart",
              "args": [] },
            { "name": "Power Slug (Yellow)", "type": "useful", "amount": 10,
              "action": "Satisfactory.GrantSlug",
              "args": [{"name": "color", "type": "string", "value": "yellow"}] },
            { "name": "Power Slug (Purple)", "type": "useful", "amount": 5,
              "action": "Satisfactory.GrantSlug",
              "args": [{"name": "color", "type": "string", "value": "purple"}] },
            { "name": "Coupons", "type": "filler", "amount": -1,
              "action": "Satisfactory.GrantCoupons",
              "args": [{"name": "amount", "type": "number", "value": 5}] },
            { "name": "Lizard Doggo Trap", "type": "trap", "amount": -1,
              "action": "Satisfactory.SpawnHostile",
              "args": [{"name": "creature", "type": "string", "value": "lizard_doggo"}] }
        ],
        "locations": [
            { "name": "Grasslands - Iron Deposit", "region": "Grasslands" },
            { "name": "Grasslands - Copper Deposit", "region": "Grasslands" },
            { "name": "Grasslands - Limestone Cave", "region": "Grasslands" },
            { "name": "Desert - Quartz Node", "region": "Desert" },
            { "name": "Desert - Caterium Deposit", "region": "Desert" },
            { "name": "Desert - Oil Seep", "region": "Desert" },
            { "name": "Forest - Coal Vein", "region": "Forest" },
            { "name": "Forest - Sulfur Deposit", "region": "Forest" },
            { "name": "Swamp - Uranium Cave", "region": "Swamp" },
            { "name": "Swamp - Bauxite Deposit", "region": "Swamp" },
            { "name": "Red Jungle - SAM Ore", "region": "Red Jungle" },
            { "name": "Red Jungle - Mercer Sphere", "region": "Red Jungle" },
            { "name": "HUB Milestone - Tier 1", "region": "Grasslands",
              "requires_count": [{"item": "HUB Parts", "count": 2}],
              "requires_option": "milestone_shuffle" },
            { "name": "HUB Milestone - Tier 2", "region": "Grasslands",
              "requires_count": [{"item": "HUB Parts", "count": 4}],
              "requires_option": "milestone_shuffle" },
            { "name": "HUB Milestone - Tier 3", "region": "Desert",
              "requires_count": [{"item": "HUB Parts", "count": 6}],
              "requires_option": "milestone_shuffle" },
            { "name": "HUB Milestone - Tier 4", "region": "Forest",
              "requires_count": [{"item": "HUB Parts", "count": 8}],
              "requires_option": "milestone_shuffle" },
            { "name": "Hard Drive - Grasslands Cave", "region": "Grasslands",
              "requires_option": "shuffle_hard_drives" },
            { "name": "Hard Drive - Desert Wreck", "region": "Desert",
              "requires_option": "shuffle_hard_drives" },
            { "name": "Hard Drive - Forest Tower", "region": "Forest",
              "requires_option": "shuffle_hard_drives" },
            { "name": "Hard Drive - Swamp Ruins", "region": "Swamp",
              "requires_option": "shuffle_hard_drives" }
        ]
    }
}
