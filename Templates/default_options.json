{
  "yaml_metadata": {
    "requires_version": "0.6.5"
  },
  "options": {
    "logic_mode": {
      "type": "text_choice",
      "choices": ["none", "basic"],
      "default": "basic",
      "description": "Logic mode: none (all locations accessible) or basic (region/item requirements enforced)"
    },
    "filler_item_weight": {
      "type": "range",
      "default": 5,
      "range_start": 1,
      "range_end": 10,
      "description": "Weight multiplier for filler items"
    },
    "trap_item_chance": {
      "type": "range",
      "default": 10,
      "range_start": 0,
      "range_end": 100,
      "description": "Percentage chance for filler items to become traps"
    }
  }
}
